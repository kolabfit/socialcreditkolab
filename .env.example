# Supabase Configuration
# Dapatkan dari: https://supabase.com → Project Settings → API
# Gunakan URL project tanpa /rest/v1/
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# Service role / secret key — HANYA untuk backend, jangan pernah di-commit atau dikirim ke frontend
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# JWT Secret — wajib, string acak panjang. Contoh generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME"

# Origin frontend yang diizinkan CORS (pisahkan dengan koma). Kosongkan saat dev (pakai proxy Vite).
CORS_ORIGIN=""

PORT=3002

# Integrasi aplikasi presensi (Sync Presensi di menu Settings HR)
# URL aplikasi presensi tanpa /api, dan kunci yang sama dengan INTEGRATION_API_KEY di .env presensi
PRESENCE_API_URL="https://absen.kolab.top"
PRESENCE_API_KEY=""

# Kunci untuk Portal Ko+Lab (endpoint GET /api/integration/scores)
INTEGRATION_API_KEY=""
